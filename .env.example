# Ergo Node
# The API key is sent on every request. Don't expose the node API over plain HTTP on the
# internet: bind it to localhost and reach it through an SSH tunnel, WireGuard or a TLS
# reverse proxy, e.g.  ssh -N -L 9053:127.0.0.1:9053 user@node-host  ->  http://127.0.0.1:9053
ERGO_NODE_URL=http://127.0.0.1:9053
ERGO_NODE_API_KEY=your_ergo_node_api_key_here

# Venues: CEX paths are off by default (on-chain only)
ENABLE_CEX=false
# USE paths are off: the USE LP was drained. Set the new ids here after the token migration.
ENABLE_USE=false
# Watch-only Kucoin/NonKYC prices (no API keys): alert when the gap to the on-chain pool is large
CEX_WATCH=true
CEX_WATCH_ALERT_PERCENT=3.0
CEX_WATCH_COOLDOWN_SECONDS=3600
# USE_TOKEN_ID=
# DEXY_USE_LP_NFT=

# NonKYC Exchange (only used when ENABLE_CEX=true)
NONKYC_API_KEY=your_nonkyc_api_key_here
NONKYC_API_SECRET=your_nonkyc_api_secret_here

# Kucoin Exchange
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_API_SECRET=your_kucoin_api_secret_here
KUCOIN_API_PASSPHRASE=your_kucoin_passphrase_here

# Arbitrage Settings
MIN_PROFIT_PERCENT=0.5
MAX_TRADE_SIZE_ERG=100
# Sizes the scanner analyses (grid columns); sizes above MAX_TRADE_SIZE_ERG are analysis only
TRADE_SIZES=10,100,200,500,1000
MIN_TRADE_SIZE_ERG=1
# Trade the smallest size that earns this share of the best possible profit (less ERG at risk
# for ~5% less profit). 1.0 = maximise profit outright.
SIZE_PROFIT_CAPTURE=0.95

# --live: auto-executes pool buy -> bank redeem only when every check passes
# Polls (CHAIN_POLL_SECONDS apart) an opportunity must hold before --live trades it
LIVE_CONFIRM_POLLS=2
LIVE_TRADE_COOLDOWN_SECONDS=300
LIVE_MAX_TRADES_PER_DAY=10
LIVE_MAX_DRAWDOWN_ERG=5
LIVE_ERG_RESERVE=1
# Kill switch: create this file (e.g. `touch STOP`) to stop live trades; delete it to resume
LIVE_STOP_FILE=STOP
# Leg 2 is watched until confirmed and rebuilt on fresh bank/oracle boxes if it drops
LEG2_WATCH_TIMEOUT_SECONDS=1200
LEG2_WATCH_INTERVAL_SECONDS=20
LEG2_MAX_REBUILDS=5
SLIPPAGE_TOLERANCE=0.01
# Max service + miner fees the TX guard allows per signed transaction
MAX_FEE_BUDGET_ERG=1.0
# SigUSD pool legs: "direct" (own pool swap, no service fee) or "crux" (~0.785 ERG per leg)
POOL_SWAP_ROUTE=direct
SCAN_INTERVAL_SECONDS=15
# How often the node is polled for pool/bank/oracle changes (incl. mempool); full scans stay on SCAN_INTERVAL_SECONDS
CHAIN_POLL_SECONDS=2

# Discord Notifications (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
DISCORD_USER_ID=your_discord_user_id_here
DISCORD_MIN_PROFIT_PERCENT=1.0
DISCORD_MIN_PROFIT_ERG=0.5
DISCORD_TIER1_PROFIT_PERCENT=2.0
DISCORD_COOLDOWN_SECONDS=300
DISCORD_CONFIRM_SCANS=3
DISCORD_WALLET_COOLDOWN_SECONDS=600
DISCORD_SUMMARY_INTERVAL_SECONDS=1800
# On-chain episode messages, health alerts and the daily digest
DISCORD_CONFIRM_SECONDS=10            # held this long before a message opens
DISCORD_CLOSE_SECONDS=10              # gone this long before it closes
DISCORD_EDIT_SECONDS=30               # at most one edit per this
DISCORD_HEALTH_CHAIN_SECONDS=120      # chain unreadable -> alert (ping)
DISCORD_HEALTH_VENUE_SECONDS=300      # CEX venue down -> alert
DISCORD_HEALTH_ORACLE_SECONDS=600     # oracle update pending -> alert
DISCORD_HEALTH_REPEAT_SECONDS=1800    # re-alert interval while still failing
DISCORD_DIGEST_HOUR=8                 # local hour for the daily digest, -1 = off
MINT_GATE_CONFIRM_POLLS=3             # agreeing polls before a mint open/close alert
MINT_GATE_MIN_ROOM_ERG=1              # smaller mint room counts as closed (default MIN_TRADE_SIZE_ERG)
MINT_GATE_PING_COOLDOWN_SECONDS=3600  # at most one mint-open ping per this
PRICE_STALE_SECONDS=60
