# Copy to .env and fill in the blanks:  cp .env.example .env
# Blank or commented-out settings use their default. Every setting with its default and effect is in
# README.md "Settings reference"; `python arb.py config` shows what the bot actually uses.
# Comments on their own line only: never put a comment after a secret.

# ---------- Node (required) ----------
# Your Ergo node's REST API. Same machine: http://127.0.0.1:9053 (Rust node default: 9099).
# Node on another machine in your LAN: http://<node-ip>:9053, with the node bound to the LAN and its
# firewall open to this machine only (README "Node setup"). Never port-forward the API to the internet.
ERGO_NODE_URL=http://127.0.0.1:9053
# The plain secret whose Blake2b-256 hash is the node's apiKeyHash (Scala) / api_key_hash (Rust)
ERGO_NODE_API_KEY=
# CHAIN_POLL_SECONDS=2
# CHAIN_STALL_SECONDS=1200
# ERGO_EXPLORER_API_URL=https://api.ergoplatform.com/api/v1

# ---------- Discord (needed for --notify) ----------
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Your numeric user id for @mentions (Discord: Settings -> Advanced -> Developer Mode, then
# right-click your name -> Copy User ID). Blank = no pings.
DISCORD_USER_ID=
# DISCORD_MIN_PROFIT_PERCENT=1.0
# DISCORD_MIN_PROFIT_ERG=0.5
# DISCORD_TIER1_PROFIT_PERCENT=2.0
# DISCORD_CONFIRM_SECONDS=10
# DISCORD_CLOSE_SECONDS=10
# DISCORD_EDIT_SECONDS=30
# DISCORD_HEALTH_CHAIN_SECONDS=120
# DISCORD_HEALTH_VENUE_SECONDS=300
# DISCORD_HEALTH_ORACLE_SECONDS=600
# DISCORD_HEALTH_REPEAT_SECONDS=1800
# STOP file holding --live this long -> alert
# DISCORD_HEALTH_LIVE_SECONDS=600
# Local hour for the daily digest, -1 = off
# DISCORD_DIGEST_HOUR=8
# Older scan-based alerts (CEX/USE paths) and the 30-minute summary
# DISCORD_CONFIRM_SCANS=3
# DISCORD_COOLDOWN_SECONDS=300
# DISCORD_WALLET_COOLDOWN_SECONDS=600
# DISCORD_SUMMARY_INTERVAL_SECONDS=1800

# ---------- Bank mint gate alerts ----------
# MINT_GATE_CONFIRM_POLLS=3
# Smaller mint room counts as closed (default: MIN_TRADE_SIZE_ERG)
# MINT_GATE_MIN_ROOM_ERG=1
# MINT_GATE_PING_COOLDOWN_SECONDS=3600
# MINT_GATE_CLOSE_SECONDS=600

# ---------- Sizing and profit ----------
# MIN_PROFIT_PERCENT=0.5
# Hard cap on anything executed (main.py --max-trade-erg overrides it for one run)
# MAX_TRADE_SIZE_ERG=100
# Sizes the scanner analyses; sizes above MAX_TRADE_SIZE_ERG are analysis only
# TRADE_SIZES=10,100,200,500,1000
# TRADE_SIZES_UNFUNDED=false
# MIN_TRADE_SIZE_ERG=1
# Trade the smallest size that earns this share of the best possible profit; 1.0 = maximise profit
# SIZE_PROFIT_CAPTURE=0.95
# SLIPPAGE_TOLERANCE=0.01
# EXECUTION_BUFFER=0.003
# Max service + miner fees the TX guard allows per signed transaction
# MAX_FEE_BUDGET_ERG=1.0
# Seconds between full scans (main.py --interval overrides it)
# SCAN_INTERVAL_SECONDS=15
# PRICE_STALE_SECONDS=60

# ---------- --live (auto-execution) ----------
# LIVE_CONFIRM_POLLS=2
# LIVE_TRADE_COOLDOWN_SECONDS=300
# LIVE_MAX_TRADES_PER_DAY=10
# LIVE_MAX_DRAWDOWN_ERG=5
# LIVE_ERG_RESERVE=1
# Sanity bounds: a profit above this, or an oracle this far from the exchanges' median price,
# is treated as bad data: nothing trades and a pinged alert is sent
# LIVE_MAX_PROFIT_PERCENT=10
# LIVE_MAX_ORACLE_DEVIATION_PERCENT=5
# Kill switch: while this file exists (relative = in the bot folder) nothing trades
# LIVE_STOP_FILE=STOP
# LEG2_WATCH_TIMEOUT_SECONDS=1200
# LEG2_WATCH_INTERVAL_SECONDS=20
# LEG2_MAX_REBUILDS=5

# ---------- Venues ----------
# ENABLE_CEX=false
# ENABLE_USE=false
# SigUSD pool legs: direct (own pool swap, miner fee only) or crux (~0.785 ERG per leg)
# POOL_SWAP_ROUTE=direct
# USE_TOKEN_ID=
# DEXY_USE_LP_NFT=
# Extra service-fee addresses (ErgoTrees, comma separated) a third-party-built TX may pay
# EXTRA_SERVICE_FEE_ERGO_TREES=
# Exchange API keys: only read with ENABLE_CEX=true (watch-only prices need none)
# NONKYC_API_KEY=
# NONKYC_API_SECRET=
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=

# ---------- CEX watch (public prices, never trades) ----------
# CEX_WATCH=true
# CEX_WATCH_ALERT_PERCENT=3.0
# CEX_WATCH_COOLDOWN_SECONDS=3600
# Gate and MEXC fees (taker fees are refreshed live; ERG withdrawal fees are not public there).
# Kucoin and NonKYC fees are read from the exchanges and are not settings.
# GATE_TRADING_FEE=0.002
# GATE_ERG_WITHDRAW_FEE=0.403
# MEXC_TRADING_FEE=0.0008
# MEXC_ERG_WITHDRAW_FEE=0.1
# SAFETRADE_ENABLED=false
# SAFETRADE_TRADING_FEE=0.002
# SAFETRADE_ERG_WITHDRAW_FEE=
# CEX_USDT_TRANSFER_FEE=1.0

# ---------- Housekeeping ----------
# SCAN_RESULTS_RETENTION_DAYS=14
